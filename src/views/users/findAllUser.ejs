<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Get All Users</title>
    <style>
        table, th, td {
            border: 1px solid black;
            border-collapse: collapse;
        }
        th, td {
            padding: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Users Table</h2>
        <table>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
            <% for(let i=0; i < dataTable.length; i++) { %>
                <tr>
                    <td><%= dataTable[i].firstName %></td>
                    <td><%= dataTable[i].lastName %></td>
                    <td><%= dataTable[i].email %></td>
                    <td><%= dataTable[i].address %></td>
                    <td>
                        <a href="/edit-crud?id=<%= dataTable[i].id %>">Edit</a> |
                        <a href="/delete-crud?id=<%= dataTable[i].id %>">Delete</a>
                    </td>
                </tr>
            <% } %>
        </table>
    </div>
</body>
</html>
